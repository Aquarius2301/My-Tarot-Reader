# ---------- Build output ----------
# dockerfile copies the whole context after `dotnet restore`, so locally built artifacts
# would otherwise overwrite the restored Linux ones and break `dotnet publish --no-restore`.
bin/
obj/
[Dd]ebug/
[Rr]elease/
*.user
*.suo

